{
  "name": "@gokayo43/dev-config",
  "version": "0.42.1",
  "description": "Shared TypeScript, oxlint, oxfmt, knip, Renovate and Lighthouse configuration for Bun projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokayo43/dev-config.git"
  },
  "files": [
    "tsconfig.base.json",
    "oxlint.base.json",
    "knip.base.ts",
    "lighthouserc.json",
    "route-log.ts"
  ],
  "type": "module",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./oxlint.base.json": "./oxlint.base.json",
    "./knip.base.ts": "./knip.base.ts",
    "./lighthouserc.json": "./lighthouserc.json",
    "./route-log.ts": "./route-log.ts"
  },
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip",
    "test": "bun test",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "drizzle-orm": "0.45.2",
    "knip": "6.29.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "eslint-import-resolver-typescript": ">=4",
    "eslint-plugin-boundaries": ">=7",
    "knip": ">=6",
    "oxfmt": ">=0.61",
    "oxlint": ">=1.76",
    "oxlint-tsgolint": ">=7",
    "typescript": ">=7"
  },
  "peerDependenciesMeta": {
    "eslint-import-resolver-typescript": {
      "optional": true
    },
    "eslint-plugin-boundaries": {
      "optional": true
    },
    "knip": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "packageManager": "bun@1.3.11",
  "lifecycle": "dev"
}

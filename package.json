{
  "name": "@gokayo43/dev-config",
  "version": "0.6.0",
  "description": "Shared TypeScript, oxlint, oxfmt, knip, Renovate and Lighthouse configuration for Bun projects.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokayo43/dev-config.git"
  },
  "files": [
    "tsconfig.base.json",
    "oxlint.base.json",
    "knip.base.ts",
    "lighthouserc.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./oxlint.base.json": "./oxlint.base.json",
    "./knip.base.ts": "./knip.base.ts",
    "./lighthouserc.json": "./lighthouserc.json"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "eslint-import-resolver-typescript": ">=4",
    "eslint-plugin-boundaries": ">=7",
    "knip": ">=6",
    "oxfmt": ">=0.61",
    "oxlint": ">=1.76",
    "oxlint-tsgolint": ">=7",
    "typescript": ">=7"
  },
  "peerDependenciesMeta": {
    "eslint-import-resolver-typescript": { "optional": true },
    "eslint-plugin-boundaries": { "optional": true },
    "knip": { "optional": true },
    "oxfmt": { "optional": true },
    "oxlint": { "optional": true },
    "oxlint-tsgolint": { "optional": true },
    "typescript": { "optional": true }
  }
}

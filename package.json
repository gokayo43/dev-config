{
  "name": "@gokayo43/dev-config",
  "version": "0.55.2",
  "description": "Shared TypeScript, oxlint, oxfmt, knip, Renovate and Lighthouse configuration for Bun projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokayo43/dev-config.git"
  },
  "bin": {
    "dev-server": "./dev-server.ts"
  },
  "files": [
    "tsconfig.base.json",
    "oxlint.base.json",
    "knip.base.ts",
    "lighthouserc.json",
    "route-log.ts",
    "dev-server.ts",
    "dev-server-derive.ts",
    "invariant-sweep.ts",
    "limiter-conformance.ts",
    "response-schema.ts",
    "characterization-net.ts",
    "anti-slop"
  ],
  "type": "module",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./oxlint.base.json": "./oxlint.base.json",
    "./knip.base.ts": "./knip.base.ts",
    "./lighthouserc.json": "./lighthouserc.json",
    "./route-log.ts": "./route-log.ts",
    "./invariant-sweep.ts": "./invariant-sweep.ts",
    "./limiter-conformance.ts": "./limiter-conformance.ts",
    "./response-schema.ts": "./response-schema.ts",
    "./characterization-net.ts": "./characterization-net.ts"
  },
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip",
    "test": "bun test",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@hughescr/stryker-bun-runner": "1.3.8",
    "@oxlint/plugins": "1.80.0",
    "@playwright/test": "1.62.1",
    "@sinclair/typebox": "0.34.52",
    "@stryker-mutator/core": "9.6.1",
    "@types/bun": "1.4.0",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.30",
    "knip": "6.33.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@playwright/test": "1.62.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "knip": "6.34.0",
    "oxfmt": "0.66.0",
    "oxlint": ">=1.79",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "eslint-import-resolver-typescript": {
      "optional": true
    },
    "eslint-plugin-boundaries": {
      "optional": true
    },
    "knip": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "packageManager": "bun@1.4.0",
  "lifecycle": "dev"
}

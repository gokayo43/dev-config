{
  "name": "@gokayo43/dev-config",
  "version": "0.70.1",
  "description": "Shared TypeScript, oxlint, oxfmt, knip, Renovate and Lighthouse configuration for Bun projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokayo43/dev-config.git"
  },
  "bin": {
    "dev-server": "./dev-server.ts"
  },
  "files": [
    "tsconfig.base.json",
    "oxlint.base.json",
    "design-system.base.json",
    "knip.base.ts",
    "lighthouserc.json",
    "dist",
    "dev-server.ts",
    "dev-server-derive.ts",
    "file-lock.ts",
    "limiter-conformance.ts",
    "property.ts",
    "interleaving.ts",
    "response-schema.ts",
    "characterization-net.ts",
    "anti-slop"
  ],
  "type": "module",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./oxlint.base.json": "./oxlint.base.json",
    "./design-system.base.json": "./design-system.base.json",
    "./knip.base.ts": "./knip.base.ts",
    "./lighthouserc.json": "./lighthouserc.json",
    "./route-log": {
      "types": "./dist/route-log.d.ts",
      "default": "./dist/route-log.js"
    },
    "./invariant-sweep": {
      "types": "./dist/invariant-sweep.d.ts",
      "default": "./dist/invariant-sweep.js"
    },
    "./count-budget": {
      "types": "./dist/count-budget.d.ts",
      "default": "./dist/count-budget.js"
    },
    "./limiter-conformance": "./limiter-conformance.ts",
    "./property": "./property.ts",
    "./interleaving": "./interleaving.ts",
    "./response-schema": "./response-schema.ts",
    "./characterization-net": "./characterization-net.ts"
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip",
    "test": "bun test",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@hughescr/stryker-bun-runner": "1.6.0",
    "@oxlint/plugins": "1.80.0",
    "@playwright/test": "1.64.1",
    "@shadcn/lint": "0.2.3",
    "@sinclair/typebox": "0.34.52",
    "@stryker-mutator/core": "9.6.1",
    "@types/bun": "1.4.4",
    "drizzle-orm": "0.45.4",
    "effect": "3.22.4",
    "elysia": "1.4.30",
    "fast-check": "4.10.2",
    "knip": "6.42.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2005",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@playwright/test": "1.64.1",
    "@shadcn/lint": "0.2.3",
    "effect": "3.22.4",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.0",
    "fast-check": "4.10.2",
    "knip": "6.44.0",
    "oxfmt": "0.75.0",
    "oxlint": ">=1.80",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@shadcn/lint": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "eslint-import-resolver-typescript": {
      "optional": true
    },
    "eslint-plugin-boundaries": {
      "optional": true
    },
    "fast-check": {
      "optional": true
    },
    "knip": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "packageManager": "bun@1.4.4",
  "lifecycle": "dev"
}

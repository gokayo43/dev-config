{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Dependency policy shared by gokayo43's Bun projects.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["* 0-6 * * 1"],
  "timezone": "Europe/Amsterdam",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "rangeStrategy": "pin",
  "dependencyDashboard": true,
  "prConcurrentLimit": 3,
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-6 * * 1"]
  },
  "packageRules": [
    {
      "description": "Non-major updates land as one automerged PR per week.",
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "Majors are read before they are merged.",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "gitleaks is pinned by tag and archive SHA-256 inside a run: block, which no built-in manager reads. github-release-attachments moves the pair together.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/(^|/)README\\.md$/"
      ],
      "matchStrings": [
        "GITLEAKS_VERSION: (?<currentValue>v\\S+)\\s+GITLEAKS_SHA256: (?<currentDigest>[0-9a-f]{64})",
        "GITLEAKS_VERSION=(?<currentValue>v\\S+)"
      ],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-release-attachments"
    }
  ]
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Dependency policy shared by gokayo43's Bun projects.",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["* 0-6 * * 1"],
  "timezone": "Europe/Amsterdam",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "rangeStrategy": "pin",
  "dependencyDashboard": true,
  "prConcurrentLimit": 3,
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-6 * * 1"]
  },
  "packageRules": [
    {
      "description": "Non-major updates land as one automerged PR per week.",
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "Majors are read before they are merged.",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Released binaries pinned by tag and archive SHA-256 inside a run: block, which no built-in manager reads. The renovate: comment above the pair names the dependency, so one manager covers every tool pinned this way.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^\\.github/actions/[^/]+/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+_VERSION: (?<currentValue>v\\S+)\\s+\\w+_SHA256: (?<currentDigest>[0-9a-f]{64})"
      ]
    },
    {
      "customType": "regex",
      "description": "The same gitleaks pin appears unhashed in this repo's local install instructions.",
      "managerFilePatterns": ["/(^|/)README\\.md$/"],
      "matchStrings": ["GITLEAKS_VERSION=(?<currentValue>v\\S+)"],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-release-attachments"
    }
  ]
}

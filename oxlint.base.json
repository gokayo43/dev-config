{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    // The one tier that stays advisory, against the rule that a warn is a count
    // nobody drives to zero. A perf hint is a claim about shared state and
    // input size the rule cannot see — `no-await-in-loop` below is off outright
    // for exactly that, and it is the tier's general case rather than its
    // exception. At `error` the rest would be answered by disables carrying a
    // measurement nobody took, which is worse than a hint nobody read.
    "perf": "warn"
  },
  "options": {
    "typeAware": true
  },
  // The house rules oxlint has no equivalent for. The specifier is relative to
  // THIS file, so a repo extending the base by node_modules path resolves it
  // without a line of its own. Plain JS on purpose — see anti-slop/index.js.
  "jsPlugins": [{ "name": "anti-slop", "specifier": "./anti-slop/index.js" }],
  "rules": {
    // Off rather than warn, against `perf` above, which turns it on for a
    // loop that awaits. In this house the awaiting loop is usually the correct
    // one: migrations applied in order, a git index written commit by commit, a
    // limiter bucket consumed one attempt at a time, a poll whose next attempt
    // exists only because the last one missed, a batch loop that IS the bound
    // on concurrency. That last one is the general case — a loop reading a file
    // per iteration holds one file's lines at a time, and the `Promise.all` this
    // rule asks for holds the whole repo's, so the advice costs memory that
    // grows with the input. None of that shared state is visible to the rule.
    // Fanning a loop out is a design call about specific shared state, made by
    // whoever can see it; it is not a default a linter is owed. The rest of
    // `perf` stays on: `unicorn/prefer-array-find` is about the code, not about
    // the concurrency model.
    "no-await-in-loop": "off",
    "no-console": "error",
    "no-empty": "error",
    "eslint/no-warning-comments": [
      "error",
      { "terms": ["todo", "fixme", "xxx", "hack"], "location": "anywhere" }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    // `never` is the only setting that refuses assertions rather than choosing a
    // syntax for them. An assertion tells the compiler to stop checking at the
    // one place the answer was still available: an annotation makes the same
    // claim and is checked, and `satisfies` makes it without widening. `as
    // const` is not an assertion in this sense and stays legal — it narrows a
    // literal rather than overriding an inference — which is why the option is
    // `assertionStyle` alone and not the literal-shaped ones beside it.
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    // The rule above refuses every assertion; this one refuses the subset of
    // them that widens or narrows unsafely, and arrives through `suspicious`.
    // Two rules over one line means every escape hatch in a source file names
    // both, and a reader of one disable cannot tell which fact it is about. So
    // the weaker of the two is stated only where the stronger is off — the
    // suite override below, where a case asserts about a value nothing typed
    // and this rule is the whole of what still holds there.
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-restricted-types": [
      "error",
      {
        "types": {
          "Record<string, unknown>": {
            "message": "define a boundary-specific alias with a reasoned suppression at its owning module, or model/parse the shape."
          },
          "Record<string, any>": {
            "message": "define a boundary-specific alias with a reasoned suppression at its owning module, or model/parse the shape. `any` also defeats every type-aware rule below."
          }
        }
      }
    ],
    "no-restricted-globals": [
      "error",
      { "name": "__dirname", "message": "Not defined in ESM — use import.meta.dir/url." },
      { "name": "__filename", "message": "Not defined in ESM — use import.meta.url/path." },
      { "name": "require", "message": "ESM project — use import (import() for dynamic)." }
    ],
    // The imports a house pick has already answered, in the two cases that hold
    // in every file. Each entry names what the import lost to, because the
    // diagnostic is the only place the loser of that decision is standing.
    //
    // Only a ban with no exception can live here: an override
    // REPLACES the whole list for the files it matches — a consuming repo's own
    // entries included — so a ban a file's position decides is a plugin rule
    // instead, whose scalar setting replaces only itself. `no-unnamed-effects`
    // and `no-raw-query-hooks` below are the two that needed it.
    //
    // Memoisation is the React Compiler's, which every repo here builds with
    // (STACK): it inserts the memo a hand-written one approximates, and reads
    // the dependencies off the code rather than off a list that can disagree
    // with it. Each name gets its own entry so each carries its own message.
    //
    // `bun:test`'s per-case hooks are the setup nothing in the case names (the
    // testing rules' per-case-setup line): a reader has to hold a hook written
    // elsewhere in the file to know what the case starts from, and the mutation
    // lane cannot tell which case a shared fixture belongs to. `beforeAll` and
    // `afterAll` stay: an expensive resource no case mutates is what they are
    // for.
    //
    // Both entries refuse a type-only import of the name as well, which this
    // rule gives no way to allow. Neither name has a use as a type.
    "no-restricted-imports": [
      "error",
      {
        "name": "react",
        "importNames": ["useMemo", "useCallback"],
        "message": "React Compiler owns memoisation — delete the wrapper and use the value directly."
      },
      {
        "name": "bun:test",
        "importNames": ["beforeEach", "afterEach"],
        "message": "Set a case up with a call it makes itself, and tear it down with `await using` — beforeAll/afterAll stay for shared immutable resources."
      }
    ],
    "unicorn/prefer-node-protocol": "error",
    "typescript/ban-ts-comment": [
      "error",
      { "ts-expect-error": "allow-with-description", "minimumDescriptionLength": 12 }
    ],
    "unicorn/no-abusive-eslint-disable": "error",
    "max-lines": ["error", { "max": 1000 }],
    "max-depth": ["error", { "max": 4 }],
    // `modified` counts a whole `switch` as one decision rather than one per
    // `case`, which is the difference between measuring the branching a reader
    // has to hold and measuring the size of a union. An exhaustive switch over a
    // discriminated union is the house shape for a total mapping —
    // `switch-exhaustiveness-check` below is what makes it total — and under the
    // classic count a union of two dozen members is over this limit by being
    // answered at all.
    "complexity": ["error", { "max": 20, "variant": "modified" }],
    "import/no-cycle": "error",
    // The automatic JSX runtime compiles JSX with no React binding in scope, so
    // there is nothing here for the rule to ask to be imported. A repo on the
    // classic runtime is the one that needs it, and is the one that would turn
    // it back on for itself.
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    // One rule carrying what `eslint-plugin-react-hooks` splits across a dozen
    // names: oxlint ports the React Compiler itself, so `react/purity` and its
    // siblings are not writable here and each judgement arrives as the prefix
    // on this rule's message. `reportAllBailouts` adds the components the
    // compiler declined to compile at all, which are silent without it.
    // Which judgements, what each one means, and how to answer the two the
    // fleet actually hits: README, "What the React Compiler declines to
    // optimize".
    "react/react-compiler": ["error", { "reportAllBailouts": true }],
    // `pedantic`, which this base does not take. `null` is the exception the
    // option carves out: `x == null` is the one loose comparison that states an
    // intent the strict operator cannot — either of the two nullish values at
    // once — and `x === null || x === undefined` is longer and says less.
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    // Its fix is to mutate the accumulator in place rather than spread into it.
    // That is right for a measured hot loop and wrong as a default for the
    // copy-on-write style these codebases are written in, where a fresh object
    // per step is what makes the step safe to reason about.
    "oxc/no-map-spread": "off",
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-env-access": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    // Everywhere, and off in the one directory that answers the question it
    // asks — see the `**/hooks/**` block below. `no-raw-query-hooks` is the
    // same pick the other way round: it says nothing until a file is a route's,
    // so it is stated in that block alone.
    "anti-slop/no-unnamed-effects": "error",
    "anti-slop/no-unsafe-dictionary-type": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        // A helper one describe uses belongs inside it, next to the cases that
        // read it. Hoisting it to module scope to satisfy this rule separates a
        // describe from the doc comment written above it, moves the helper away
        // from its only caller, and renames whatever its locals now collide
        // with — three costs for a file that is read case by case.
        "unicorn/consistent-function-scoping": "off",
        // The four smells a suite has to be free of before its green means
        // anything, and the only four in this plugin scoped to where they are
        // smells: every one of them is ordinary code in a source file.
        "anti-slop/no-call-log-assertions": "error",
        "anti-slop/no-local-module-mocks": "error",
        "anti-slop/no-mock-assertions": "error",
        "anti-slop/no-real-timers": "error"
      }
    },
    {
      "files": ["src/server/**", "server/**", "apps/api/**"],
      "rules": {
        "no-console": "error"
      }
    },
    {
      "files": ["**/env.ts"],
      "rules": {
        // The one module that reads the environment, which is what makes the
        // rule above sayable everywhere else. Deliberately this one name and no
        // variant of it: a second env module is a second place the answer comes
        // from, so a repo that needs one writes the switch-off itself and the
        // reason for it, rather than inheriting a glob that already forgave it.
        "anti-slop/no-env-access": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/tests/**",
        "**/e2e/**"
      ],
      "rules": {
        // A suite is where a variable is SET, not where one is read for its
        // value: a case spawns the thing under test with an environment it
        // wrote, and reads the runner's own to find a binary, a temp directory
        // or the throwaway database it was pointed at. None of that is a repo's
        // configuration and there is no `env.ts` for it to come from. The
        // directories go with the suffixes because a suite's helpers — the
        // fixture that spawns, the migrator it runs, the harness that lints —
        // are that same code one file over, and are the half a suffix list
        // silently leaves failing.
        "anti-slop/no-env-access": "off",

        // A case asserts about values the compiler has no way to know the shape
        // of — a decoded report, a captured payload, a row read back out of a
        // database — and the assertion is the claim the case is there to make.
        // The same directories as above, for the same reason: the fixture that
        // decodes is the suite's code one file over.
        "typescript/consistent-type-assertions": "off",

        // And the subset of it left standing where that is off: an assertion a
        // case makes about a value it decoded is the claim, but one that widens
        // or narrows unsafely is still a hole, and this is the only scope where
        // saying so does not repeat the rule above.
        "typescript/no-unsafe-type-assertion": "error"
      }
    },
    // The two picks a file's position decides. Both are plugin rules rather
    // than `no-restricted-imports` entries, because a scalar setting in an
    // override replaces only itself: a list-shaped rule redefined here would
    // take away every entry it did not restate, a consuming repo's own settled
    // decisions included.
    {
      "files": ["**/routes/**"],
      "rules": {
        // A route's data is the loader's — `ensureQueryData` there,
        // `useSuspenseQuery` in the component (STACK's Route data line) — so
        // this rule says nothing at all until a file is a route's, and this
        // block is where it starts.
        "anti-slop/no-raw-query-hooks": "error"
      }
    },
    {
      "files": ["**/hooks/**"],
      "rules": {
        // The directory that answers the question the rule asks. A hook is the
        // module an effect is allowed to live in, because the hook's name is
        // what states the subscription — and this block is last so that a hook
        // colocated under `routes/` is graded as a hook, which is also why the
        // rule below is off again here: data fetched on interaction is what raw
        // `useQuery` is for, and a hook is where that fetch belongs.
        "anti-slop/no-unnamed-effects": "off",
        "anti-slop/no-raw-query-hooks": "off"
      }
    }
  ]
}

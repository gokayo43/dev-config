{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": {
    "typeAware": true
  },
  // The house rules oxlint has no equivalent for. The specifier is relative to
  // THIS file, so a repo extending the base by node_modules path resolves it
  // without a line of its own. Plain JS on purpose — see anti-slop/index.js.
  "jsPlugins": [{ "name": "anti-slop", "specifier": "./anti-slop/index.js" }],
  "rules": {
    "no-console": "warn",
    "no-empty": "error",
    "eslint/no-warning-comments": [
      "error",
      { "terms": ["todo", "fixme", "xxx", "hack"], "location": "anywhere" }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-restricted-types": [
      "error",
      {
        "types": {
          "Record<string, unknown>": {
            "message": "define a boundary-specific alias with a reasoned suppression at its owning module, or model/parse the shape."
          },
          "Record<string, any>": {
            "message": "define a boundary-specific alias with a reasoned suppression at its owning module, or model/parse the shape. `any` also defeats every type-aware rule below."
          }
        }
      }
    ],
    "no-restricted-globals": [
      "error",
      { "name": "__dirname", "message": "Not defined in ESM — use import.meta.dir/url." },
      { "name": "__filename", "message": "Not defined in ESM — use import.meta.url/path." },
      { "name": "require", "message": "ESM project — use import (import() for dynamic)." }
    ],
    "unicorn/prefer-node-protocol": "error",
    "typescript/ban-ts-comment": [
      "error",
      { "ts-expect-error": "allow-with-description", "minimumDescriptionLength": 12 }
    ],
    "unicorn/no-abusive-eslint-disable": "error",
    "max-lines": ["error", { "max": 1000 }],
    "max-depth": ["warn", { "max": 4 }],
    "complexity": ["warn", { "max": 20 }],
    "import/no-cycle": "error",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "oxc/no-map-spread": "off",
    "typescript/await-thenable": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/prefer-nullish-coalescing": "warn",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        // A helper one describe uses belongs inside it, next to the cases that
        // read it. Hoisting it to module scope to satisfy this rule separates a
        // describe from the doc comment written above it, moves the helper away
        // from its only caller, and renames whatever its locals now collide
        // with — three costs for a file that is read case by case.
        "unicorn/consistent-function-scoping": "off",
        // An override REPLACES a rule's whole configuration rather than adding
        // to it (oxc#12179), so the ESM globals lock is restated here — drop it
        // and test files silently regain `__dirname`, `require`, `__filename`.
        "no-restricted-globals": [
          "error",
          { "name": "__dirname", "message": "Not defined in ESM — use import.meta.dir/url." },
          { "name": "__filename", "message": "Not defined in ESM — use import.meta.url/path." },
          { "name": "require", "message": "ESM project — use import (import() for dynamic)." }
        ],
        // The four smells a suite has to be free of before its green means
        // anything, and the only four in this plugin scoped to where they are
        // smells: every one of them is ordinary code in a source file.
        "anti-slop/no-call-count-assertions": "error",
        "anti-slop/no-local-module-mocks": "error",
        "anti-slop/no-mock-assertions": "error",
        "anti-slop/no-real-timers": "error"
      }
    },
    {
      "files": ["src/server/**", "server/**", "apps/api/**"],
      "rules": {
        "no-console": "error"
      }
    }
  ]
}
